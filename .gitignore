# ------------------------------------------------------------------
# NCMS-SITE — root ignore rules
# ------------------------------------------------------------------

# Node
node_modules/
.pnp
.pnp.js

# Environment / secrets (never commit!)
.env
.env.*
!.env.example
!.env.sample

# Build output
.next/
out/
dist/
build/
coverage/

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lsof.out

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# TypeScript
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------
# Legacy / out-of-scope (kept locally, not pushed)
# ------------------------------------------------------------------

# Strapi CMS (legacy — replaced by the custom Express + MongoDB backend)
ncms-cms-main/

# Work artifacts (site-map / test spreadsheets)
*.xlsx
make_ncms_sitemap.js

# Stray leftover file
ncms-web-main/exit

# Session transcripts (never commit)
session-*.md
